___TESTS___

scenarios:
- name: page views set the config and inject the pinned script
  code: |-
    let injected;
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      injected = url;
      onSuccess();
    });
    runCode({action: 'pageViews', writeKey: ' wk_0123456789abcdef0123456789abcdef ', outboundLinks: false, fileDownloads: false});
    assertApi('setInWindow').wasCalledWith('analyticsTrendConfig', {writeKey: 'wk_0123456789abcdef0123456789abcdef'}, true);
    assertThat(injected).isEqualTo('https://cdn.jsdelivr.net/npm/@analyticstrend/web@0.9.0/dist/script.js');
    assertApi('gtmOnSuccess').wasCalled();
- name: link options reach the config as strings
  code: |-
    mock('injectScript', function(url, onSuccess) {
      onSuccess();
    });
    runCode({action: 'pageViews', writeKey: 'wk_0123456789abcdef0123456789abcdef', outboundLinks: true, fileDownloads: true});
    assertApi('setInWindow').wasCalledWith('analyticsTrendConfig', {writeKey: 'wk_0123456789abcdef0123456789abcdef', outboundLinks: 'true', fileDownloads: 'true'}, true);
- name: a script that fails to load fails the tag
  code: |-
    mock('injectScript', function(url, onSuccess, onFailure) {
      onFailure();
    });
    runCode({action: 'pageViews', writeKey: 'wk_0123456789abcdef0123456789abcdef'});
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: a malformed key fails the tag without injecting
  code: |-
    runCode({action: 'pageViews', writeKey: 'pk_123'});
    assertApi('gtmOnFailure').wasCalled();
    assertApi('injectScript').wasNotCalled();
    assertApi('setInWindow').wasNotCalled();
- name: an uppercase key is not a write key
  code: |-
    runCode({action: 'pageViews', writeKey: 'wk_0123456789ABCDEF0123456789abcdef'});
    assertApi('gtmOnFailure').wasCalled();
    assertApi('injectScript').wasNotCalled();
- name: an event is queued with its properties
  code: |-
    let queueName;
    let pushed;
    mock('createQueue', function(name) {
      queueName = name;
      return function(item) {
        pushed = item;
      };
    });
    runCode({action: 'event', eventName: 'signup', eventProperties: [{name: 'plan', value: 'pro'}]});
    assertThat(queueName).isEqualTo('analyticsTrendQueue');
    assertThat(pushed).isEqualTo(['signup', {plan: 'pro'}]);
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: an event without properties is queued with its name alone
  code: |-
    let pushed;
    mock('createQueue', function(name) {
      return function(item) {
        pushed = item;
      };
    });
    runCode({action: 'event', eventName: 'download'});
    assertThat(pushed).isEqualTo(['download']);
- name: an event once AnalyticsTrend has loaded is sent at once
  code: |-
    mock('copyFromWindow', function(name) {
      if (name === 'analyticsTrendStartedKey') return 'wk_0123456789abcdef0123456789abcdef';
      return undefined;
    });
    runCode({action: 'event', eventName: 'signup', eventProperties: [{name: 'plan', value: 'pro'}]});
    assertApi('callInWindow').wasCalledWith('analyticsTrend.track', 'signup', {plan: 'pro'});
    assertApi('createQueue').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: an event without a name fails the tag
  code: |-
    runCode({action: 'event', eventName: '  '});
    assertApi('gtmOnFailure').wasCalled();
    assertApi('createQueue').wasNotCalled();
setup: ''


