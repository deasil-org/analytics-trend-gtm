___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const callInWindow = require('callInWindow');
const createQueue = require('createQueue');
const makeString = require('makeString');
const makeTableMap = require('makeTableMap');
const logToConsole = require('logToConsole');

const SCRIPT_URL = 'https://cdn.jsdelivr.net/npm/@analyticstrend/web@0.9.0/dist/script.js';
const HEX = '0123456789abcdef';
const SPACE = ' \t\n\r';

function trim(text) {
  let start = 0;
  let end = text.length;
  while (start < end && SPACE.indexOf(text.charAt(start)) >= 0) start++;
  while (end > start && SPACE.indexOf(text.charAt(end - 1)) >= 0) end--;
  return text.substring(start, end);
}

// wk_ followed by 32 lowercase hexadecimal characters.
function isWriteKey(key) {
  if (key.length !== 35 || key.substring(0, 3) !== 'wk_') return false;
  for (let i = 3; i < key.length; i++) {
    if (HEX.indexOf(key.charAt(i)) < 0) return false;
  }
  return true;
}

function sendEvent() {
  const name = trim(makeString(data.eventName));
  if (!name) {
    logToConsole('AnalyticsTrend: the event has no name');
    data.gtmOnFailure();
    return;
  }
  const props = data.eventProperties && data.eventProperties.length ? makeTableMap(data.eventProperties, 'name', 'value') : null;
  if (copyFromWindow('analyticsTrendStartedKey')) {
    // Already loaded: send it now.
    if (props) callInWindow('analyticsTrend.track', name, props);
    else callInWindow('analyticsTrend.track', name);
  } else {
    // Not loaded yet: AnalyticsTrend sends what is queued when it starts.
    createQueue('analyticsTrendQueue')(props ? [name, props] : [name]);
  }
  data.gtmOnSuccess();
}

function countPageViews() {
  const key = trim(makeString(data.writeKey));
  if (!isWriteKey(key)) {
    logToConsole('AnalyticsTrend: the write key is not a website write key');
    data.gtmOnFailure();
    return;
  }
  // Tag Manager can't set attributes on the script it adds, so the options
  // go in a page global the script reads when it starts.
  const config = { writeKey: key };
  if (data.outboundLinks) config.outboundLinks = 'true';
  if (data.fileDownloads) config.fileDownloads = 'true';
  setInWindow('analyticsTrendConfig', config, true);
  injectScript(SCRIPT_URL, data.gtmOnSuccess, data.gtmOnFailure, SCRIPT_URL);
}

if (data.action === 'event') sendEvent();
else countPageViews();


